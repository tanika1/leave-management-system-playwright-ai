{
  "name": "lms-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript automation framework for Leave Management System",
  "scripts": {
    "install:pw": "npx playwright install --with-deps",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:e2e": "playwright test --project=e2e",
    "report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/node": "^20.12.12",
    "dotenv": "^16.4.5",
    "typescript": "^5.4.5"
  }
}
